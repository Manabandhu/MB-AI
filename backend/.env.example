DATABASE_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=manabandhu_app.your-project-ref
DATABASE_PASSWORD=replace-with-your-database-password
# Local runs never migrate the hosted database; the deployed backend and the migrate workflow do.
SPRING_FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
SUPABASE_JWKS_URI=https://lpzaioyurvgdysdfktzc.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://lpzaioyurvgdysdfktzc.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
GRAPHIQL_ENABLED=true
# Only honoured with the local auth stub (scripts/local-dev/start.sh); against hosted Supabase it is ignored and
# logged as an error, so keep it false there.
ADMIN_PUBLIC_ACCESS_ENABLED=false
AUTOMATION_GITHUB_REPOSITORY=owner/repository
AUTOMATION_GITHUB_TOKEN=replace-with-fine-grained-token-with-actions-write
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*],http://192.168.*:[*],http://10.*:[*],exp://*
GOOGLE_MAPS_SERVER_KEY=
# Expo push delivery (notification dispatcher). Leave false locally; set true where deployed.
PUSH_NOTIFICATIONS_ENABLED=false
# Only needed when the Expo project enables enhanced push security.
EXPO_ACCESS_TOKEN=
