EXPO_PUBLIC_API_URL=https://congenial-bassoon-97xr6pppqpv5cvv7-8080.app.github.dev/
EXPO_PUBLIC_SUPABASE_URL=https://lpzaioyurvgdysdfktzc.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: Google Maps JavaScript key for map display on web. Restrict it by HTTP referrer in Google Cloud.
# Directions, Places and Geocoding run through the backend (GOOGLE_MAPS_SERVER_KEY) so their key stays private.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Android native maps key, read by app.config.js at build time (set it as an EAS secret for store builds).
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: public web origin used in shared links (e.g. https://app.example.com). Without it, links use the app
# scheme on native and the current origin on web.
EXPO_PUBLIC_WEB_URL=
# Optional: domain for iOS universal links / Android App Links, read by app.config.js at build time. The domain must
# serve the matching apple-app-site-association and assetlinks.json files.
APP_LINK_DOMAIN=
# Expo (EAS) project id; push notification registration stays off until it is set (build-time, app.config.js).
EAS_PROJECT_ID=
