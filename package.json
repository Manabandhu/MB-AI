{
  "name": "manabandhu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @manabandhu/frontend start",
    "dev:backend": "node scripts/dev-backend.mjs",
    "lint": "biome check frontend/src package.json pnpm-workspace.yaml biome.json scripts && pnpm --filter @manabandhu/frontend typecheck",
    "format": "biome format --write .",
    "test": "pnpm --filter @manabandhu/frontend test && ./backend/mvnw -f backend/pom.xml test",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:skills": "node scripts/verify-module-skills.mjs",
    "verify": "pnpm lint && pnpm verify:contracts && pnpm verify:skills",
    "review:commit": "node scripts/review-commit.mjs",
    "commit:message": "node scripts/generate-commit-message.mjs",
    "commit:message:check": "node scripts/validate-commit-message.mjs",
    "review:history": "node scripts/review-skill-history.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "pnpm hooks:install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10"
  }
}
