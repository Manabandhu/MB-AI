# Copy to .env and fill in. Every model layer is switchable with one line.
# Three ready-made setups are at the bottom of this file.

# ---------------------------------------------------------------- required
# Long random string; the web app and desktop recorder sign in with it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me
POSTGRES_PASSWORD=change-me-too
# How you appear in transcripts (your mic channel). Other people sign in with their own tokens or SSO.
OWNER_NAME=Me
# Signs audio links and webhook URLs. Defaults to API_TOKEN; set it if you use SSO without API_TOKEN.
SECRET_KEY=
# The address people (and bot providers) use to reach this server, e.g. https://copilot.example.com
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- single sign-on (optional)
# Any OIDC provider: Keycloak, Cognito, Entra ID, Okta. Register a public web client with redirect URI
# <PUBLIC_BASE_URL>/auth/callback. New users get a personal workspace on first sign-in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_ALLOWED_DOMAINS=

# ---------------------------------------------------------------- speech to text
# faster_whisper (open source, runs in the worker) | deepgram (paid API) | fake (demo)
STT_PROVIDER=faster_whisper
# GPU: large-v3-turbo. CPU only: small.en or distil-small.en (large models are very slow on CPU).
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
WHISPER_LANGUAGE=en
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Team words the transcriber should spell right (systems, products, names), comma separated
GLOSSARY=

# ---------------------------------------------------------------- live assist
# Streaming STT during meetings: faster_whisper (small model, re-decoded every second) | sherpa_onnx
# (NeMo streaming FastConformer / Parakeet-style transducer in SHERPA_MODEL_DIR) | deepgram | fake | none
LIVE_STT_PROVIDER=faster_whisper
LIVE_WHISPER_MODEL=small.en
SHERPA_MODEL_DIR=
# A small fast model for answer cards (defaults to LLM_MODEL / BEDROCK_MODEL_ID)
LIVE_LLM_MODEL=
BEDROCK_LIVE_MODEL_ID=
# Below this retrieval similarity the card says "Not in your history — say you'll follow up"
LIVE_ANSWER_MIN_SCORE=0.25
LIVE_SUMMARY_EVERY_S=300

# ---------------------------------------------------------------- who spoke when
# pyannote (open source) | none (everyone on the call is one speaker) | fake (demo)
DIARIZER=pyannote
# Hugging Face token; accept the terms of pyannote/speaker-diarization-community-1 first
HF_TOKEN=

# ---------------------------------------------------------------- voiceprints (opt-in)
# speechbrain (ECAPA-TDNN, open source) | none | fake. Enrollment needs each person's consent; only
# embeddings are stored. The threshold is model-specific: calibrate it with Insights → Gates.
VOICEPRINT_PROVIDER=speechbrain
VOICEPRINT_THRESHOLD=0.55

# ---------------------------------------------------------------- meeting bot (optional)
# attendee | vexa | recall | none. The bot's name announces that it records. Needs PUBLIC_BASE_URL.
BOT_PROVIDER=none
BOT_NAME=Meeting Copilot (recording)
ATTENDEE_API_URL=https://app.attendee.dev
ATTENDEE_API_KEY=
VEXA_API_URL=
VEXA_API_KEY=
RECALL_API_URL=https://us-east-1.recall.ai
RECALL_API_KEY=

# ---------------------------------------------------------------- summaries and chat
# openai_compat (Ollama, vLLM, LM Studio, any OpenAI-style server) | bedrock (Claude on AWS) | fake
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=gpt-oss:20b
# For LLM_PROVIDER=bedrock: a Claude model or inference profile ID from the Bedrock console
BEDROCK_MODEL_ID=
BEDROCK_REGION=
# Transcripts longer than this are condensed in windows first (fits smaller context windows)
LLM_MAX_INPUT_CHARS=48000

# ---------------------------------------------------------------- search embeddings
# openai_compat | bedrock (Titan Text Embeddings v2) | fake
EMBED_PROVIDER=openai_compat
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_MODEL=nomic-embed-text
# Must match the model: nomic-embed-text = 768. Titan v2 = 256, 512 or 1024.
EMBED_DIM=768

# ---------------------------------------------------------------- storage and privacy
# local (Docker volume) | s3
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=us-east-1
# Audio is deleted after this many days; transcripts and summaries stay. 0 keeps audio forever.
AUDIO_RETENTION_DAYS=30
# Mask emails, phone, card and SSN numbers in transcripts
PII_REDACTION=true
PII_CATEGORIES=email,phone,card,ssn
MAX_UPLOAD_MB=1024

# ---------------------------------------------------------------- network
# 127.0.0.1 keeps the app private to this machine. Use the tls profile + DOMAIN to expose it.
API_BIND=127.0.0.1
API_PORT=8000
DOMAIN=

# ---------------------------------------------------------------- integrations (defaults)
# Each workspace can override these in Settings → Integrations.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOS=
CALENDAR_ICS_URL=
AUTO_POST_SUMMARIES=false

# ================================================================ ready-made setups
#
# A) Fully open source on a GPU box (default above):
#      STT_PROVIDER=faster_whisper  DIARIZER=pyannote  LLM_PROVIDER=openai_compat  EMBED_PROVIDER=openai_compat
#    Start with: make up-gpu   (includes Ollama and the live service)   then: make pull-models
#
# B) Paid APIs, no GPU needed:
#      STT_PROVIDER=deepgram  DEEPGRAM_API_KEY=...  LIVE_STT_PROVIDER=deepgram
#      DIARIZER=none                     (Deepgram labels speakers itself)
#      LLM_PROVIDER=bedrock  BEDROCK_MODEL_ID=...
#      EMBED_PROVIDER=bedrock  EMBED_DIM=1024
#    Start with: make up
#
# C) Demo with no models at all (placeholder transcripts and summaries, everything else real):
#      STT_PROVIDER=fake  DIARIZER=fake  LLM_PROVIDER=fake  EMBED_PROVIDER=fake  EMBED_DIM=64
#      LIVE_STT_PROVIDER=fake  VOICEPRINT_PROVIDER=fake  BOT_PROVIDER=fake
#    Start with: make demo
